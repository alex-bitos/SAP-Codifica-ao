{
  "name": "gerador-codigos-sap-multiusuario",
  "version": "4.0.0",
  "private": true,
  "description": "Gerador e Controle de Códigos SAP multiusuário com PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/cli/migrate.ts",
    "admin:create": "tsx src/cli/create-admin.ts",
    "import:initial": "tsx src/cli/import-initial.ts",
    "seed:v311": "tsx src/cli/seed-v311.ts",
    "audit:v311": "npm run build && node scripts/generate-v311-assets.mjs",
    "verify:homologation": "tsx src/cli/verify-homologation.ts",
    "test:visual": "node scripts/visual-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "playwright": "^1.63.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
